--- !u!114 &8068412767915546887
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5857786464324186661}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "CONVERGENCE\r\nA SAVAGE LEGENDS GAME\\n\r\n\r\nTHANK YOU FOR PLAYING!\\n\\n\r\n\r\nSTUDENT
    TEAM DEVELOPERS:\\n\r\nHead of Code, Chaos, & Crisis Management - Jeremy Desfosses\\n\r\nInterface
    Alchemist & Menu Magician - Zachery Burlakoff\\n\r\nDungeon Daddy - Dylan Williams\\n\r\nSound
    Sorcerer & Monster Wrangler - Teresa Shaver\\n\r\nMaster of Bullets, Bandages,
    & Bad Surprises - Michael Witkowski\\n\r\nChief Shopkeeper & Part-Time Pixel
    Pusher - Kylar Eden-Potach\\n\\n\r\n\r\nA Special Thanks to our Teachers:\\n\r\nGrandmaster
    of C# Spells & Unity Basics - Prof. Rod Moye\\n\r\nSprint Master and Trelloist
    - Prof. John O'Leske\\n\r\nThe Rapid Response Reviewer - Prof. Shawn Paris\\n\\n\r\n\r\nEarly
    Development Contributers: \\n\r\nCode Consultant from a Parallel Timeline: Sam
    Haan\\n\r\nPrototype Support Developer: Austin Carey\\n\r\n\r\nA Heartfelt (&
    Slightly Chaotic) Thank\u2011You:\\n\r\nTo our families, friends, roommates,
    & emotional\u2011support snacks \\n\r\nThank you for cheering us on, testing
    our game, & pretending to understand what we were talking about.\\n\\n\r\n\r\nA
    Funny Blip for our Third Party Contributors:\\n\r\nFor Assets of All Kinds:\\n\r\nTo
    every generous soul who uploaded a model, texture, particle effect, or mysterious
    prefab \u2014\r\nwe couldn\u2019t have done it without your digital treasure
    hoard.\\n\r\n\r\nMusic & SFX: Thank you for the bangers, the booms, & all the
    weird noises\\n\r\nTwilight Game Menu(Short, Pixabay) by Siarhei Korbut from
    Pixabay.com/music\\n\r\nGame Over (retrowaver, synthwave, vaporwave, retro, 80's)
    by Artur Aravidi Music from pixabay.com/music\\n\r\nTense Suspense Background
    Music by HitsLab from pixabay.com/music\\n\r\nJonathon Gaming by Onetent from
    Pixabay.com/music\\n\r\nSynthwave Shooter music pack by Alkakrab from itch.io\\n\r\nEpic
    Cinematic Battle Music by Tunetank from Pixabay.com/music \\n\r\nBro Audio by
    Ami Production from assetstore.unity.com\\n\r\nFantasy SFX for Particle Distort
    Texture Effect Library by Moonflower Carnivore from assetstore.unity.com\\n\r\nFast
    UI Sounds - Sound Effects by AD Sounds from assetstore.unity.com\\n\r\nMonster
    Roars - Audio Pack by VoiceBosch from assetstore.unity.com\\n\r\nRPG Essentials
    Sound Effects - FREE! by leohpaz from assetstore.unity.com\\n\r\nSci-fi Guns
    SFX Pack by Mikael Vanninen from assetstore.unity.com\\n\r\nCybernetic Onslaught
    (Aggressive Heavy Metal for Gaming & Action) by NickPanek from Pixabay.com/music\r\nThe
    Eternal Drone by NickPanek from Pixabay.com/music\r\nHydraulic Line Burst Synthwave
    nu Metal by Tunetank from Pixabay.com/music\r\n\r\nCharacters & Animation & VFX:\\n\r\nThank
    you, your models survived our code. That alone deserves an applause.\\n\r\nDragon
    for Boss Monster:PBR by Dungeon Mason from assetstore.unity.com\\n\r\nEgypt Pack
    by OpenLab from assetstore.unity.com\\n\r\nFREE-32 RPG Animations by Blink from
    assetstore.unity.com\\n\r\nFree Fire VFX - URP by Vefects from assetstore.unity.com\\n\r\nHit
    Effects FREE by Matthew Guz from assetstore.unity.com\\n\r\nHumanoid Robot Avatar
    Set - Mecanim Compatible by LB3D from assetstore.unity.com\\n\r\nInsectoid Crab
    Monster:Lurker of the Shores(20 Animations) by LB3D from assetstore.unity.com\\n\r\nMagic
    Effects FREE by Hovl Studio from assetstore.unity.com\\n\r\nProcedural Fire by
    Hovl Studio from assetstore.unity.com\\n\r\nSci-Fi Drones by Lukas Bobor from
    assetstore.unity.com\\n\r\n\r\n\r\nLevel Design Resources:\\n\r\nThank you. you
    gave us props & enviroments that helped us transform empty space into a game.
    \\n\r\nCity Voxel Pack by PoeMe from assetstore.unity.com\\n\r\nFirst Aid Jar
    by SIUP from assetstore.unity.com\\n\r\nFree Industrial building/Garage by Reinforcedcc
    from assetstore.unity.com\\n\r\nFree Lava Shader by AYproduct from assetstore.unity.com\\n\r\nRPG/FPS
    Game Assets for PC/Mobile (Industrial Set V.2.0 by Dmitri Kutsenko from assetstore.unity.com\\n\r\nRusty
    Cars by Duane's Mind from assetstore.unity.com\\n\r\nSci-Fi guns|Plug and Play
    by The Developer Train from assetstore.unity.com\\n\r\nSimple Keys by 3Digitalis
    from assetstore.unity.com\\n\r\nTower Defense Sci-Fi Turret (FREE) by Firazdo
    from assetstore.unity.com\\n\r\nVending Machines - Lowpoly 3D Pixel Art Pack
    by F____ Up Design from assetstore.unity.com\\n\r\nAmmoBox by BeatHeart Creative
    Studio from assetstore.unity.com\\n\r\n \r\n\r\nMade with <3 in Unity\\n\r\n\xA9
    2025 Savage Legends"
  m_isRightToLeft: 0
